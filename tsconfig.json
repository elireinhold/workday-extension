{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "data-text:*": ["node_modules/plasmo/src/type-declarations/global.d.ts"],
      "~*": ["src/*"]
    },
    "types": ["chrome"]
  }
}